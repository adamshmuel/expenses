# Dependencies — reinstall with `npm install`, never commit them.
node_modules/

# Build output
dist/
build/
coverage/

# Secrets. The Gemini API key and the JWT secrets live in .env, which must
# never reach GitHub. .env.example is committed instead: same keys, no values.
.env
.env.*
!.env.example

# Winston writes here (see the logging demo in the course).
logs/
*.log

# macOS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?

# AI tooling config and AI-authored root docs — kept on disk for local use,
# never tracked or pushed. Fresh clones will not have these; see the project
# owner before relying on git history to restore them.
.claude/
.github/
opencode.json
/*.md
!/README.md
CLAUDE.local.md
